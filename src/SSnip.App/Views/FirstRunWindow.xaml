<ui:FluentWindow
    x:Class="SSnip.App.Views.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SSnip.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SSnip.App.ViewModels"
    Title="Welcome to SSnip"
    Width="880"
    Height="720"
    MinWidth="720"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:FirstRunViewModel}"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Welcome to SSnip" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="32,8,32,16">
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Step" />
                <Run Text="{Binding StepNumber, Mode=OneWay}" />
                <Run Text="of 3" />
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Padding="32,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!--  Step 1: library folder  -->
                <StackPanel Visibility="{Binding IsLibraryStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,8" FontSize="26" FontWeight="SemiBold" Text="Where should your footage go?" />
                    <TextBlock
                        Margin="0,0,0,20"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="SSnip keeps each project in its own folder here, with raw downloads, clips, audio, frames and subtitles. Pick a drive with plenty of space."
                        TextWrapping="Wrap" />
                    <DockPanel>
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding BrowseCommand}"
                            Content="Browse…"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:TextBox PlaceholderText="D:\Footage" Text="{Binding LibraryRoot, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource UnhealthyBrush}"
                        Text="{Binding LibraryError}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Step 2: tools  -->
                <StackPanel DataContext="{Binding Tools}" Visibility="{Binding DataContext.IsToolsStep, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,8" FontSize="26" FontWeight="SemiBold" Text="Get the tools" />
                    <TextBlock
                        Margin="0,0,0,20"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="SSnip drives yt-dlp, FFmpeg and Deno. They are downloaded from their official releases into SSnip's own folder, about 120 MB in total. If you already have a copy, use it instead."
                        TextWrapping="Wrap" />
                    <controls:ToolList />
                    <ui:InfoBar
                        Title="Download failed"
                        Margin="0,4,0,8"
                        IsClosable="False"
                        IsOpen="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}, Mode=OneWay}"
                        Message="{Binding ErrorMessage}"
                        Severity="Error" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding InstallMissingCommand}"
                            Content="Download missing"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                        <ui:Button Command="{Binding InstallMissingCancelCommand}" Content="Cancel" />
                    </StackPanel>
                </StackPanel>

                <!--  Step 3: self-check  -->
                <StackPanel Visibility="{Binding IsCheckStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,0,0,8" FontSize="26" FontWeight="SemiBold" Text="Self-check" />
                    <TextBlock
                        Margin="0,0,0,20"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Each tool runs and reports its version, yt-dlp confirms it can use Deno as its JavaScript runtime, and a 5-second test download proves everything works together."
                        TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Tools.Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolRowViewModel}">
                                <ui:Card Margin="0,0,0,6" Padding="16,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Card Margin="0,0,0,6" Padding="16,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Tools.JavaScriptRuntime, TargetNullValue='Not found'}" />
                            <TextBlock FontWeight="SemiBold" Text="yt-dlp JavaScript runtime" />
                        </DockPanel>
                    </ui:Card>
                    <ui:Card Margin="0,0,0,6" Padding="16,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TestDownloadText}" />
                            <TextBlock FontWeight="SemiBold" Text="5-second test download" />
                        </DockPanel>
                    </ui:Card>

                    <ui:ProgressRing
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        IsIndeterminate="True"
                        Visibility="{Binding IsSelfChecking, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:InfoBar
                        Title="All set"
                        Margin="0,12,0,0"
                        IsClosable="False"
                        IsOpen="{Binding SelfCheckPassed, Mode=OneWay, TargetNullValue=False}"
                        Message="Everything works. Finish to open SSnip."
                        Severity="Success" />
                    <ui:InfoBar
                        Title="Self-check failed"
                        Margin="0,12,0,0"
                        IsClosable="False"
                        IsOpen="{Binding SelfCheckPassed, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}, TargetNullValue=False}"
                        Message="{Binding Tools.ErrorMessage, TargetNullValue='A tool did not respond. Go back to fix it, then run the check again.'}"
                        Severity="Error" />
                    <ui:Button
                        Margin="0,12,0,0"
                        Command="{Binding RunSelfCheckCommand}"
                        Content="Run check again"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="3"
            Padding="32,16"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding BackCommand}" Content="Back" />
                <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Command="{Binding NextCommand}"
                    Content="Next"
                    Visibility="{Binding IsCheckStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding FinishCommand}"
                    Content="Finish"
                    Visibility="{Binding IsCheckStep, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
