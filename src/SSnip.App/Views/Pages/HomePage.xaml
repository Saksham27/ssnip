<Page
    x:Class="SSnip.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SSnip.App.ViewModels"
    Title="Home"
    d:DataContext="{d:DesignInstance vm:HomeViewModel}"
    AllowDrop="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.InputBindings>
        <KeyBinding Command="{Binding PasteAndFetchCommand}" Gesture="Ctrl+V" />
        <KeyBinding Command="{Binding DownloadWithDefaultPresetCommand}" Gesture="Ctrl+Return" />
    </Page.InputBindings>

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Home" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Paste or drop a video, playlist or channel link, pick a preset and send it to the queue. Ctrl+V pastes and fetches, Ctrl+Enter downloads Editor-safe." />
            </StackPanel>

            <!--  Link input  -->
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Top" DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding FetchCommand}"
                        Content="Fetch"
                        Icon="{ui:SymbolIcon Search24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding FetchCancelCommand}"
                        Content="Cancel"
                        Visibility="{Binding IsFetching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <ui:TextBox
                    x:Name="LinkBox"
                    MaxHeight="120"
                    AcceptsReturn="True"
                    PlaceholderText="Paste one or more links, one per line"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
            </DockPanel>

            <StackPanel Grid.Row="2">
                <ui:ProgressRing
                    Margin="0,8,0,8"
                    HorizontalAlignment="Left"
                    IsIndeterminate="True"
                    Visibility="{Binding IsFetching, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:InfoBar
                    Title="Could not fetch"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{Binding FetchError, Converter={StaticResource IsNotNullConverter}, Mode=OneWay}"
                    Message="{Binding FetchError}"
                    Severity="Error" />
                <ui:InfoBar
                    Title="Note"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{Binding Notice, Converter={StaticResource IsNotNullConverter}, Mode=OneWay}"
                    Message="{Binding Notice}"
                    Severity="Informational" />
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Visibility="{Binding HasPendingLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding AddLinksToQueueCommand}"
                        Content="{Binding AddLinksText}"
                        Icon="{ui:SymbolIcon AddSquareMultiple24}" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding OpenQueueCommand}" Content="Open queue" Icon="{ui:SymbolIcon TextBulletListLtr24}" />
                </StackPanel>
                <ui:InfoBar
                    Title="Cannot download"
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{Binding DownloadError, Converter={StaticResource IsNotNullConverter}, Mode=OneWay}"
                    Message="{Binding DownloadError}"
                    Severity="Error" />
            </StackPanel>

            <Grid Grid.Row="3" Visibility="{Binding HasInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="520" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!--  Info panel  -->
                <ui:Card Grid.Column="0" VerticalAlignment="Top" Padding="16">
                    <StackPanel>
                        <Border Margin="0,0,0,12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                            <Image MaxHeight="280" Source="{Binding Info.ThumbnailUrl, TargetNullValue={x:Null}}" Stretch="Uniform" />
                        </Border>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Info.Title}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,6,0,12" Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Info.Channel}" />
                            <Border Style="{StaticResource Badge}">
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="{Binding InfoKindText}" />
                            </Border>
                        </StackPanel>
                        <Grid Visibility="{Binding IsDownloadable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,0,16,4" Style="{StaticResource Label}" Text="Duration" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DurationText}" />
                            <TextBlock Grid.Row="1" Margin="0,0,16,4" Style="{StaticResource Label}" Text="Uploaded" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UploadDateText}" />
                            <TextBlock Grid.Row="2" Margin="0,0,16,4" Style="{StaticResource Label}" Text="Views" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewsText}" />
                            <TextBlock Grid.Row="3" Margin="0,0,16,4" Style="{StaticResource Label}" Text="Subtitles" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubtitlesText}" TextWrapping="Wrap" />
                        </Grid>

                        <Expander Margin="0,12,0,0" Header="Chapters" Visibility="{Binding HasChapters, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Chapters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChapterRowViewModel}">
                                            <DockPanel Margin="0,2">
                                                <CheckBox MinWidth="0" Margin="0,0,6,0" DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" />
                                                <TextBlock Width="72" VerticalAlignment="Center" DockPanel.Dock="Left" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StartText}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Chapter.Title}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Margin="0,8,0,0" Command="{Binding DownloadTickedChaptersCommand}" Content="Download ticked chapters as clips" Icon="{ui:SymbolIcon Cut24}" />
                            </StackPanel>
                        </Expander>
                        <Expander Margin="0,8,0,0" Header="Description">
                            <TextBox
                                MaxHeight="240"
                                IsReadOnly="True"
                                Text="{Binding Info.Description, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </ui:Card>

                <StackPanel Grid.Column="2">
                    <!--  Single video or live stream: download and progress  -->
                    <ui:Card Margin="0,0,0,12" Padding="16" Visibility="{Binding IsDownloadable, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding DownloadCommand}"
                                    Content="{Binding DownloadText}"
                                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                                <ui:Button Margin="8,0,0,0" Command="{Binding ClipCommand}" Content="Clip" Icon="{ui:SymbolIcon Cut24}" ToolTip="Mark clips on a fast preview, then download only those at full quality" />
                                <ui:Button Margin="8,0,0,0" Command="{Binding ToggleCommandCommand}" Content="Show command" Icon="{ui:SymbolIcon Code24}" />
                                <ui:Button Margin="8,0,0,0" Command="{Binding OpenQueueCommand}" Content="Open queue" Icon="{ui:SymbolIcon TextBulletListLtr24}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenFolderCommand}"
                                    Content="Open folder"
                                    Icon="{ui:SymbolIcon FolderOpen24}"
                                    Visibility="{Binding TrackedJob.HasFile, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <CheckBox Content="Record from the start of the stream (otherwise from now)" IsChecked="{Binding LiveFromStart}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource Label}" Text="Stop recording in the progress below or in the Queue; what was recorded is kept as a playable file." TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0" DataContext="{Binding TrackedJob}" Visibility="{Binding DataContext.IsJobVisible, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button
                                            Command="{Binding DataContext.StopTrackedRecordingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Content="Stop recording"
                                            Icon="{ui:SymbolIcon RecordStop24}"
                                            Visibility="{Binding CanStopRecording, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:Button
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.CancelTrackedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Content="Cancel"
                                            Icon="{ui:SymbolIcon Dismiss24}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StageText}" TextWrapping="Wrap" />
                                </DockPanel>
                                <ProgressBar
                                    Height="6"
                                    Margin="0,8,0,8"
                                    IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                    Maximum="100"
                                    Value="{Binding ProgressValue, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock MinWidth="64" FontWeight="SemiBold" Text="{Binding PercentText}" />
                                    <TextBlock MinWidth="170" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SizeText}" />
                                    <TextBlock MinWidth="110" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SpeedText}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding EtaText}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Detail, Converter={StaticResource IsNotNullToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsCommandVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,6">
                                    <ui:Button Command="{Binding CopyCommandCommand}" Content="Copy" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Copy24}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Label}" Text="Exact command" />
                                </DockPanel>
                                <TextBox
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Text="{Binding CommandLine, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!--  Playlist or channel: pick videos  -->
                    <ui:Card Margin="0,0,0,12" Padding="16" Visibility="{Binding IsPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ui:Button Margin="8,0,0,0" Command="{Binding OpenQueueCommand}" Content="Open queue" DockPanel.Dock="Right" Icon="{ui:SymbolIcon TextBulletListLtr24}" />
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding AddSelectedToQueueCommand}"
                                    Content="{Binding AddSelectedText}"
                                    DockPanel.Dock="Right"
                                    Icon="{ui:SymbolIcon ArrowDownload24}" />
                                <StackPanel DockPanel.Dock="Right" Margin="0,0,16,0" Orientation="Horizontal" Visibility="{Binding IsChannelWithTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Tab" />
                                    <ComboBox Width="120" DisplayMemberPath="Name" ItemsSource="{Binding ChannelTabChoices}" SelectedItem="{Binding SelectedChannelTab}" />
                                </StackPanel>
                                <TextBlock Margin="0" VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Videos" />
                            </DockPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="8" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ui:TextBox Grid.Column="0" PlaceholderText="Title contains… or /regex/" Text="{Binding TitleFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                <ui:NumberBox Grid.Column="2" ClearButtonEnabled="False" Minimum="0" PlaceholderText="Min minutes" SpinButtonPlacementMode="Hidden" Value="{Binding MinMinutes}" />
                                <ui:NumberBox Grid.Column="4" ClearButtonEnabled="False" Minimum="0" PlaceholderText="Max minutes" SpinButtonPlacementMode="Hidden" Value="{Binding MaxMinutes}" />

                                <DockPanel Grid.Row="2" Grid.Column="0">
                                    <ui:Button Margin="8,0,0,0" Command="{Binding ApplyItemListCommand}" Content="Select items" DockPanel.Dock="Right" />
                                    <ui:TextBox PlaceholderText="Items, e.g. 1:10,15,20-22" Text="{Binding ItemList, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <DatePicker Grid.Row="2" Grid.Column="2" SelectedDate="{Binding DateAfter}" ToolTip="Only videos uploaded on or after this date (checked as each one downloads)" />
                                <DatePicker Grid.Row="2" Grid.Column="4" SelectedDate="{Binding DateBefore}" ToolTip="Only videos uploaded on or before this date (checked as each one downloads)" />
                            </Grid>

                            <DockPanel Margin="0,0,0,8">
                                <ui:NumberBox Width="150" ClearButtonEnabled="False" DockPanel.Dock="Right" Minimum="1" PlaceholderText="Max downloads" SpinButtonPlacementMode="Hidden" Value="{Binding MaxDownloads}" />
                                <ui:Button Command="{Binding SelectAllCommand}" Content="Select all" />
                                <ui:Button Margin="8,0,0,0" Command="{Binding SelectNoneCommand}" Content="Select none" />
                                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Label}" Text="{Binding EntriesSummary}" />
                            </DockPanel>
                            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding PlaylistError}" TextWrapping="Wrap" Visibility="{Binding PlaylistError, Converter={StaticResource IsNotNullToVisibilityConverter}}" />

                            <ui:ListView
                                Height="380"
                                ItemsSource="{Binding Entries}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionMode="Single"
                                VirtualizingPanel.IsVirtualizing="True">
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlaylistEntryViewModel}">
                                        <DockPanel Margin="0,2">
                                            <CheckBox MinWidth="0" Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" />
                                            <TextBlock Width="44" VerticalAlignment="Center" DockPanel.Dock="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Index}" />
                                            <TextBlock Margin="12,0,16,0" VerticalAlignment="Center" DockPanel.Dock="Right" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DurationText}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Label}" Text="Each video becomes its own job with the preset and extras below. Upload dates are checked by yt-dlp as each one starts." TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <!--  Format selection  -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ui:ToggleSwitch Content="Advanced" DockPanel.Dock="Right" IsChecked="{Binding IsAdvanced}" Visibility="{Binding IsDownloadable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="0" Style="{StaticResource SectionTitle}" Text="Format" />
                            </DockPanel>

                            <!--  Simple: presets  -->
                            <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PresetOption}">
                                            <StackPanel Margin="4,6">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding IsAudioOnlySelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Audio format" />
                                    <ComboBox MinWidth="140" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding SelectedAudioFormat}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Advanced: every format  -->
                            <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource Label}" Text="Click a row to use it as the video or audio part. Click a column header to sort." />
                                <DataGrid
                                    Height="320"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding Formats}"
                                    SelectedItem="{Binding SelectedFormatRow}"
                                    SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Id}" Header="ID" />
                                        <DataGridTextColumn Binding="{Binding Container}" Header="Ext" />
                                        <DataGridTextColumn Binding="{Binding Kind}" Header="Has" />
                                        <DataGridTextColumn Binding="{Binding Resolution}" Header="Resolution" SortMemberPath="Height" />
                                        <DataGridTextColumn Binding="{Binding FpsText}" Header="FPS" SortMemberPath="Fps" />
                                        <DataGridTextColumn Binding="{Binding VideoCodec}" Header="Video codec" />
                                        <DataGridTextColumn Binding="{Binding AudioCodec}" Header="Audio codec" />
                                        <DataGridTextColumn Binding="{Binding BitrateText}" Header="Bitrate" SortMemberPath="Bitrate" />
                                        <DataGridTextColumn Binding="{Binding SizeText}" Header="Size" SortMemberPath="Size" />
                                        <DataGridTextColumn Binding="{Binding Hdr}" Header="HDR" />
                                        <DataGridTextColumn Binding="{Binding Protocol}" Header="Protocol" />
                                        <DataGridTemplateColumn Header="Note" SortMemberPath="Note">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:FormatRow}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Note}" />
                                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsPremium, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="Premium" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,12,8" VerticalAlignment="Center" Text="Video" />
                                    <ComboBox Grid.Column="1" Margin="0,0,0,8" DisplayMemberPath="Label" ItemsSource="{Binding VideoChoices}" SelectedItem="{Binding SelectedVideo}" />
                                    <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Audio" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" DisplayMemberPath="Label" ItemsSource="{Binding AudioChoices}" SelectedItem="{Binding SelectedAudio}" />
                                    <TextBlock Grid.Row="2" Margin="0,0,12,0" VerticalAlignment="Center" Text="Sort (-S)" />
                                    <ui:TextBox Grid.Row="2" Grid.Column="1" PlaceholderText="Optional, for example res:1440,fps,vcodec:av01" Text="{Binding SortString, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SortChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Margin="0,0,6,6"
                                                Padding="10,3"
                                                Appearance="Secondary"
                                                Command="{Binding DataContext.ToggleSortChipCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding EstimatedSizeText}" />
                                <TextBlock Style="{StaticResource Label}" Text="Chosen formats win over the sort string. Leave both pickers on None to use only the sort." TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!--  Subtitles, metadata and SponsorBlock  -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <Expander Header="Subtitles, metadata and SponsorBlock">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Subtitles" />
                                <CheckBox Content="Download subtitles" IsChecked="{Binding SubtitlesEnabled}" />
                                <Grid Margin="28,8,0,0" IsEnabled="{Binding SubtitlesEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,0,12,8" VerticalAlignment="Center" Text="Languages" />
                                    <ui:TextBox Grid.Column="1" Width="220" Margin="0,0,0,8" HorizontalAlignment="Left" PlaceholderText="en, hi" Text="{Binding SubtitleLanguagesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Language codes in priority order, for example en, hi. Only the first one the video has is downloaded: manual subtitles first, then auto-generated captions in the language spoken." />
                                    <TextBlock Grid.Row="1" Margin="0,0,12,8" VerticalAlignment="Center" Text="Save as" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Width="220" Margin="0,0,0,8" HorizontalAlignment="Left" DisplayMemberPath="Name" ItemsSource="{Binding SubtitleModes}" SelectedItem="{Binding SelectedSubtitleMode}" />
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Also take auto-generated captions" IsChecked="{Binding IncludeAutoSubtitles}" />
                                </Grid>

                                <TextBlock Margin="0,16,0,10" Style="{StaticResource SectionTitle}" Text="Metadata" />
                                <WrapPanel>
                                    <CheckBox Margin="0,0,24,8" Content="Embed metadata" IsChecked="{Binding EmbedMetadata}" />
                                    <CheckBox Margin="0,0,24,8" Content="Embed chapters" IsChecked="{Binding EmbedChapters}" />
                                    <CheckBox Margin="0,0,24,8" Content="Embed thumbnail" IsChecked="{Binding EmbedThumbnail}" ToolTip="Some editors show an embedded cover as a second video stream" />
                                    <CheckBox Margin="0,0,24,8" Content="Save description and 200 comments" IsChecked="{Binding SaveComments}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Label}" Text="info.json is always saved to SSnip's data folder for the source log, not next to the video." TextWrapping="Wrap" />

                                <DockPanel Margin="0,16,0,10">
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SponsorBlockEnabled}" />
                                    <TextBlock Margin="0" Style="{StaticResource SectionTitle}" Text="SponsorBlock" />
                                </DockPanel>
                                <ItemsControl IsEnabled="{Binding SponsorBlockEnabled}" ItemsSource="{Binding SponsorBlockCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SponsorBlockCategoryViewModel}">
                                            <DockPanel Margin="0,0,16,8">
                                                <ComboBox Width="120" DockPanel.Dock="Right" ItemsSource="{x:Static vm:SponsorBlockCategoryViewModel.Actions}" SelectedItem="{Binding Action}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Label}" Text="Remove cuts the segment out; Mark adds it as a chapter. Preview proxies only ever mark, so their timestamps match the original." TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </ui:Card>

                    <!--  Options  -->
                    <ui:Card Margin="0,0,0,12" Padding="16">
                        <Expander Header="Options">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Margin="0,0,16,10" VerticalAlignment="Center" Text="Folder" />
                                <DockPanel Grid.Column="1" Margin="0,0,0,10">
                                    <ui:Button Margin="8,0,0,0" Command="{Binding ChangeOutputDirectoryCommand}" Content="Change…" DockPanel.Dock="Right" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding OutputDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputDirectory}" />
                                </DockPanel>

                                <TextBlock Grid.Row="1" Margin="0,0,16,4" VerticalAlignment="Center" Text="File name" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" IsEditable="True" ItemsSource="{Binding FilenameTemplateChoices}" Text="{Binding FilenameTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource Label}" Text="{Binding FilenamePreview, StringFormat=Preview: {0}}" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="3" Margin="0,0,16,10" VerticalAlignment="Center" Text="Container" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Width="160" Margin="0,0,0,10" HorizontalAlignment="Left" ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" />

                                <TextBlock Grid.Row="4" Margin="0,0,16,10" VerticalAlignment="Center" Text="Network" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Orientation="Horizontal">
                                    <ui:TextBox Width="140" PlaceholderText="Rate limit, e.g. 5M" Text="{Binding RateLimit, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave empty for no limit. Examples: 500K, 5M" />
                                    <TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Text="Fragments (-N)" />
                                    <ui:NumberBox Width="120" ClearButtonEnabled="False" Maximum="16" Minimum="1" SpinButtonPlacementMode="Inline" Value="{Binding ConcurrentFragments}" />
                                </StackPanel>

                                <CheckBox Grid.Row="5" Grid.Column="1" Content="Overwrite if the file already exists (otherwise skip)" IsChecked="{Binding Overwrite}" />
                            </Grid>
                        </Expander>
                    </ui:Card>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
