<Page
    x:Class="SSnip.App.Views.Pages.ClipEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:vm="clr-namespace:SSnip.App.ViewModels"
    x:Name="Root"
    Title="Clip editor"
    d:DataContext="{d:DesignInstance vm:ClipEditorViewModel}"
    Focusable="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Transport" BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Command="{Binding OpenLocalFileCommand}" Content="Open a file…" Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Clip editor" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SourceTitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <ui:InfoBar
                Title="Clip editor"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding Status, Converter={StaticResource IsNotNullConverter}, Mode=OneWay}"
                Message="{Binding Status}"
                Severity="Informational" />
            <StackPanel Margin="0,0,0,8" DataContext="{Binding ProxyJob}" Visibility="{Binding DataContext.ProxyJob, ElementName=Root, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                <TextBlock Text="{Binding StageText}" />
                <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>
            <ui:Card Padding="24" Visibility="{Binding HasSource, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Fetch a video on Home and press Clip, or open a video file on disk. Keys: I and O set in and out, Enter adds the clip, J K L play backwards, pause and forwards (press again to go faster), arrow keys step a frame, Ctrl+Z undoes." TextWrapping="Wrap" />
            </ui:Card>
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding HasSource, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!--  Player, timeline and marks  -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom">
                    <!--  Timeline: clips, marks and the play head  -->
                    <Grid x:Name="Timeline" Height="34" Margin="0,10,0,0">
                        <Border Height="8" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" />
                        <ItemsControl ItemsSource="{Binding Clips}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Top" Value="11" />
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource TimeToOffsetConverter}">
                                                <Binding Path="In" />
                                                <Binding ElementName="Root" Path="DataContext.LengthMs" />
                                                <Binding ElementName="Timeline" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ClipRowViewModel}">
                                    <Border Height="12" Background="{DynamicResource SystemAccentColorPrimaryBrush}" CornerRadius="2" Opacity="0.75">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource RangeToWidthConverter}">
                                                <Binding Path="In" />
                                                <Binding Path="Out" />
                                                <Binding ElementName="Root" Path="DataContext.LengthMs" />
                                                <Binding ElementName="Timeline" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Width="2" Height="34" Fill="#FF6CCB5F" Visibility="{Binding InPoint, Converter={StaticResource HasValueToVisibilityConverter}}">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource TimeToOffsetConverter}">
                                        <Binding Path="InPoint" />
                                        <Binding Path="LengthMs" />
                                        <Binding ElementName="Timeline" Path="ActualWidth" />
                                    </MultiBinding>
                                </Canvas.Left>
                            </Rectangle>
                            <Rectangle Width="2" Height="34" Fill="#FFFF99A4" Visibility="{Binding OutPoint, Converter={StaticResource HasValueToVisibilityConverter}}">
                                <Canvas.Left>
                                    <MultiBinding Converter="{StaticResource TimeToOffsetConverter}">
                                        <Binding Path="OutPoint" />
                                        <Binding Path="LengthMs" />
                                        <Binding ElementName="Timeline" Path="ActualWidth" />
                                    </MultiBinding>
                                </Canvas.Left>
                            </Rectangle>
                        </Canvas>
                        <Slider
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsMoveToPointEnabled="True"
                            Maximum="{Binding LengthMs}"
                            Minimum="0"
                            Opacity="0.85"
                            Value="{Binding PositionMs}" />
                    </Grid>

                    <!--  Transport  -->
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock FontFamily="Consolas" FontSize="16" Text="{Binding PositionText}" />
                            <TextBlock Margin="6,0" FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="/" />
                            <TextBlock FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LengthText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding ReverseCommand}" Icon="{ui:SymbolIcon Rewind24}" Style="{StaticResource Transport}" ToolTip="Play backwards (J, again for faster)" />
                            <ui:Button Command="{Binding StepBackCommand}" Icon="{ui:SymbolIcon Previous24}" Style="{StaticResource Transport}" ToolTip="Back one frame (Left)" />
                            <ui:Button Command="{Binding PlayPauseCommand}" Icon="{ui:SymbolIcon Play24}" Style="{StaticResource Transport}" ToolTip="Play or pause (K or Space)" />
                            <ui:Button Command="{Binding StepForwardCommand}" Icon="{ui:SymbolIcon Next24}" Style="{StaticResource Transport}" ToolTip="Forward one frame (Right)" />
                            <ui:Button Command="{Binding ForwardCommand}" Icon="{ui:SymbolIcon FastForward24}" Style="{StaticResource Transport}" ToolTip="Play forwards (L, again for faster)" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Style="{StaticResource Label}" Text="{Binding SpeedText}" />
                        </StackPanel>
                    </DockPanel>

                    <!--  Marks  -->
                    <DockPanel Margin="0,10,0,0">
                        <ui:Button Appearance="Primary" Command="{Binding AddClipCommand}" Content="Add clip (Enter)" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Add24}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding SetInCommand}" Content="Set in (I)" Style="{StaticResource Transport}" />
                            <TextBlock MinWidth="90" Margin="4,0,16,0" FontFamily="Consolas" Foreground="#FF6CCB5F" Style="{StaticResource Label}" Text="{Binding InText}" />
                            <ui:Button Command="{Binding SetOutCommand}" Content="Set out (O)" Style="{StaticResource Transport}" />
                            <TextBlock MinWidth="90" Margin="4,0,16,0" FontFamily="Consolas" Foreground="#FFFF99A4" Style="{StaticResource Label}" Text="{Binding OutText}" />
                            <TextBlock FontFamily="Consolas" Style="{StaticResource Label}" Text="{Binding MarkLengthText}" />
                        </StackPanel>
                    </DockPanel>

                    <!--  Frames  -->
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Margin="0,0,8,8" Command="{Binding GrabFrameCommand}" Content="Grab frame (full quality PNG)" Icon="{ui:SymbolIcon Camera24}" />
                        <TextBlock Margin="0,0,6,8" Style="{StaticResource Label}" Text="Every" />
                        <ui:NumberBox Width="110" Margin="0,0,6,8" ClearButtonEnabled="False" Maximum="600" Minimum="0.5" SpinButtonPlacementMode="Hidden" Value="{Binding FrameEverySeconds}" />
                        <TextBlock Margin="0,0,8,8" Style="{StaticResource Label}" Text="s" />
                        <ui:Button Margin="0,0,8,8" Command="{Binding GrabFramesEveryCommand}" Content="Grab frames" />
                        <ui:Button Margin="0,0,8,8" Command="{Binding ContactSheetCommand}" Content="Contact sheet" />
                        <ui:Button Margin="0,0,8,8" Command="{Binding SaveThumbnailCommand}" Content="Save thumbnail" />
                        <ui:Button Margin="0,0,8,8" Command="{Binding OpenFolderCommand}" CommandParameter="frames" Content="Frames folder" Icon="{ui:SymbolIcon FolderOpen24}" />
                    </WrapPanel>
                </StackPanel>

                <!--  The page scrolls inside the navigation frame, so the player needs a height limit to leave room for the controls.  -->
                <Border MinHeight="240" MaxHeight="520" Background="Black" CornerRadius="6">
                    <vlc:VideoView x:Name="Video" />
                </Border>
            </DockPanel>

            <!--  Clips and output  -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:Card Margin="0,0,0,12" Padding="12">
                        <StackPanel>
                            <DockPanel>
                                <ui:Button Command="{Binding UndoCommand}" Content="Undo" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="Ctrl+Z" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding ClipCount, StringFormat=Clips ({0})}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Clips}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ClipRowViewModel}">
                                        <Border Margin="0,0,0,8" Padding="8" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <ui:Button Padding="6,4" Appearance="Transparent" Command="{Binding DataContext.DeleteClipCommand, ElementName=Root}" CommandParameter="{Binding}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove the clip" />
                                                    <ui:Button Padding="6,4" Appearance="Transparent" Command="{Binding DataContext.JumpToCommand, ElementName=Root}" CommandParameter="{Binding}" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Play24}" ToolTip="Go to the in point" />
                                                    <ui:TextBox PlaceholderText="Name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                                </DockPanel>
                                                <StackPanel Margin="0,6,0,6" Orientation="Horizontal">
                                                    <TextBlock FontFamily="Consolas" Text="{Binding InText}" />
                                                    <TextBlock Margin="6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="→" />
                                                    <TextBlock FontFamily="Consolas" Text="{Binding OutText}" />
                                                    <TextBlock Margin="12,0,0,0" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LengthText}" />
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox PlaceholderText="Tags" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                                    <ui:TextBox Grid.Column="2" PlaceholderText="Note" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,12" Padding="12">
                        <Expander Header="Import timestamps">
                            <StackPanel Margin="0,8,0,0">
                                <ui:TextBox
                                    Height="96"
                                    AcceptsReturn="True"
                                    PlaceholderText="12:30-13:10 Soap scene&#x0a;1:02:15 - 1:03:00 Final mission"
                                    Text="{Binding TimestampText, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button Margin="0,0,8,0" Command="{Binding ImportTimestampsCommand}" Content="Add as clips" />
                                    <ui:Button Margin="0,0,8,0" Command="{Binding ScanDescriptionCommand}" Content="Scan the description" Visibility="{Binding CanScanDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ui:Button Command="{Binding AddChaptersCommand}" Content="Add chapters" Visibility="{Binding HasChapters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </ui:Card>

                    <ui:Card Margin="0,0,0,12" Padding="12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Output" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="0,0,12,8" Style="{StaticResource Label}" Text="Quality" Visibility="{Binding IsLocal, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <ComboBox Grid.Column="1" Margin="0,0,0,8" DisplayMemberPath="Name" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" Visibility="{Binding IsLocal, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Row="1" Margin="0,0,12,8" Style="{StaticResource Label}" Text="Handles" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Width="40" DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding HandleSeconds, StringFormat={}{0:0.#} s}" TextAlignment="Right" />
                                    <Slider IsSnapToTickEnabled="True" Maximum="5" Minimum="0" TickFrequency="0.5" ToolTip="Padding before and after each clip, for transitions" Value="{Binding HandleSeconds}" />
                                </DockPanel>
                                <TextBlock Grid.Row="2" Margin="0,0,12,8" Style="{StaticResource Label}" Text="Cut" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" DisplayMemberPath="Name" ItemsSource="{Binding CutModes}" SelectedItem="{Binding SelectedCutMode}" />
                                <TextBlock Grid.Row="3" Margin="0,0,12,8" Style="{StaticResource Label}" Text="Profile" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" DisplayMemberPath="Name" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
                                <TextBlock Grid.Row="4" Margin="0,0,12,8" Style="{StaticResource Label}" Text="Frame rate" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Orientation="Horizontal">
                                    <ComboBox Width="110" ItemsSource="{Binding FpsChoices}" SelectedItem="{Binding TargetFps}" ToolTip="Empty keeps the source frame rate" />
                                    <TextBlock Margin="12,0,8,0" Style="{StaticResource Label}" Text="Height" />
                                    <ComboBox Width="110" ItemsSource="{Binding HeightChoices}" SelectedItem="{Binding TargetHeight}" ToolTip="Empty keeps the source size" />
                                </StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                                    <CheckBox Content="Constant frame rate (avoids audio drift in editors)" IsChecked="{Binding ConstantFrameRate}" />
                                    <CheckBox Content="PCM audio (MOV) instead of AAC" IsChecked="{Binding PcmAudio}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource Label}" Text="{Binding EncoderText}" TextWrapping="Wrap" />
                            <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Command="{Binding DownloadClipsCommand}" Content="{Binding DownloadClipsText}" Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding OpenFolderCommand}" CommandParameter="clips" Content="Clips folder" Icon="{ui:SymbolIcon FolderOpen24}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
