<Page
    x:Class="SSnip.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SSnip.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SSnip.App.ViewModels"
    Title="Settings"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,16" FontSize="28" FontWeight="SemiBold" Text="Settings" />

        <!--  Downloads, Clipping, Account and Advanced tabs arrive with their phases.  -->
        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" Margin="0,16,0,0" HorizontalAlignment="Left">
                        <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Folder24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Library folder" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LibraryRoot, TargetNullValue='Not set'}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0" Command="{Binding OpenLibraryRootCommand}" Content="Open" />
                                <ui:Button Command="{Binding ChangeLibraryRootCommand}" Content="Change…" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="App data" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AppDataFolder}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0" Command="{Binding OpenLogsCommand}" Content="Logs" />
                                <ui:Button Command="{Binding OpenAppDataFolderCommand}" Content="Open" />
                            </StackPanel>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" Margin="0,16,0,0" HorizontalAlignment="Left" DataContext="{Binding Tools}">
                        <TextBlock
                            Margin="0,0,0,12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="SSnip runs these tools from its own bin folder. yt-dlp updates itself; the others are downloaded again."
                            TextWrapping="Wrap" />
                        <controls:ToolList />
                        <ui:InfoBar
                            Title="Something went wrong"
                            Margin="0,4,0,8"
                            IsClosable="False"
                            IsOpen="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}, Mode=OneWay}"
                            Message="{Binding ErrorMessage}"
                            Severity="Error" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding InstallMissingCommand}"
                                Content="Download missing"
                                Icon="{ui:SymbolIcon ArrowDownload24}" />
                            <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Check again" />
                            <ui:Button Command="{Binding OpenBinFolderCommand}" Content="Open bin folder" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
