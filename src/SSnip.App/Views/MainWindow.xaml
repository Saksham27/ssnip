<ui:FluentWindow
    x:Class="SSnip.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:SSnip.App.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SSnip.App.ViewModels"
    Title="SSnip"
    Width="1600"
    Height="950"
    MinWidth="1280"
    MinHeight="720"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <ui:FluentWindow.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Queue.TaskbarState}" ProgressValue="{Binding Queue.TaskbarValue}" />
    </ui:FluentWindow.TaskbarItemInfo>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SSnip" />

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            PaneDisplayMode="LeftFluent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:HomePage}" />
                <ui:NavigationViewItem Content="Search" Icon="{ui:SymbolIcon Search24}" TargetPageType="{x:Type pages:SearchPage}" />
                <ui:NavigationViewItem Content="Clip editor" Icon="{ui:SymbolIcon Cut24}" TargetPageType="{x:Type pages:ClipEditorPage}" />
                <ui:NavigationViewItem Content="Queue" Icon="{ui:SymbolIcon ArrowDownload24}" TargetPageType="{x:Type pages:QueuePage}" />
                <ui:NavigationViewItem Content="Library" Icon="{ui:SymbolIcon Library24}" TargetPageType="{x:Type pages:LibraryPage}" />
                <ui:NavigationViewItem Content="Channels" Icon="{ui:SymbolIcon VideoClipMultiple24}" TargetPageType="{x:Type pages:ChannelsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!--  Status bar: tool health, queue summary, account mode  -->
        <Border
            Grid.Row="2"
            Padding="16,6"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" ToolTip="{Binding Tools.BinFolder}">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource UnhealthyBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tools.AllHealthy}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource HealthyBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Tools.HealthSummary}" />
                </StackPanel>

                <TextBlock
                    Margin="32,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Queue.Summary}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="PersonCircle24" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Account mode: Off" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAccountModeOn}" Value="True">
                                        <Setter Property="Text" Value="Account mode: On" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
